  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px" },

  "motion": { "duration": "180ms", "ease": "cubic-bezier(0.34, 1.36, 0.64, 1)" },

  "touch": { "minTarget": "48px", "note": "staff use these on phones, one-handed, sometimes wet hands" },

  "format": {
    "currency": { "code": "BDT", "symbol": "৳", "decimals": 0, "pattern": "BDT {amount}" },
    "date": "YYYY-MM-DD",
    "timezone": "Asia/Dhaka",
    "locales": ["en-BD", "bn-BD"]
